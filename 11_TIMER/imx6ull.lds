SECTIONS {
   /* 设置程序的起始链接地址为 0x87800000。
      这是代码在 DDR（内存）中的绝对运行地址，
      必须与 start.S 中设置的栈指针等内存地址相匹配。 */
   . = 0X87800000;

   /* 定义代码段 (.text)，存放所有的程序指令 */
   .text :
   {
      obj/start.o    /* 强制将启动文件 start.o 放在整个程序的最开头。
                        因为 CPU 上电复位后，第一条指令必须从这里开始执行。 */
      *(.text)       /* 将其余所有文件 (.o) 的代码段按顺序排在后面。 */
   }

   /* 定义只读数据段 (.rodata)，存放 const 修饰的常量、字符串等。
      ALIGN(4) 表示该段起始地址必须 4 字节对齐，提高 CPU 读取效率。 */
   .rodata ALIGN(4) : {
      *(.rodata*)
   }

   /* 定义已初始化数据段 (.data)，存放被显式赋了初值的全局变量和静态变量。
      同样要求 4 字节对齐。 */
   .data ALIGN(4) : {
      *(.data)
   }

   /* 定义两个全局符号，标记 BSS 段的起始和结束位置。
      这两个符号会被 start.S 中的 .extern 引用，用于在启动时将该段内存清零。 */
   . = ALIGN(4);
   __bss_start = .;

   /* 定义未初始化数据段 (.bss)，存放未赋初值的全局变量和静态变量。
      *(.bss) 匹配所有文件的 .bss 段，*(COMMON) 匹配未初始化的全局符号。 */
   .bss ALIGN(4) : {
      *(.bss)
      *(COMMON)
   }

   __bss_end = .;
}